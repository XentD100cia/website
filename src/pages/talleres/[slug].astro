---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { talleresRealizados } from '../../data/talleresRealizados.js';

export function getStaticPaths() {
  return talleresRealizados.map((taller) => ({
    params: { slug: taller.slug },
    props: { taller }
  }));
}

const { taller } = Astro.props;
---

<BaseLayout
  title={`${taller.title} | XentD100cia`}
  description={taller.excerpt}
  image={taller.image}
  type="article"
>
  <Navbar />

  <main>
    <section class="px-5 pt-40 pb-16 md:pt-48 md:pb-20">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
          {taller.category ?? 'Talleres'}
        </p>

        <h1 class="font-heading text-5xl font-extrabold leading-tight text-ink md:text-7xl">
          {taller.title}
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-soft md:text-xl md:leading-9">
          {taller.excerpt}
        </p>

        <p class="mt-6 text-sm font-bold uppercase tracking-[0.2em] text-soft">
          {taller.date}
        </p>
      </div>
    </section>

    <section class="px-5 py-12 md:py-16">
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 overflow-hidden rounded-[32px] shadow-soft">
          {taller.image ? (
            <img
              src={taller.image}
              alt={taller.title}
              class="h-[420px] w-full object-cover"
            />
          ) : (
            <div class="h-[420px] w-full bg-line"></div>
          )}
        </div>

        <article class="rounded-[32px] bg-white p-8 shadow-sm md:p-12">
          <div class="prose prose-lg max-w-none text-soft">
            {taller.content?.map((paragraph) => (
              <p class="mb-6 leading-8">
                {paragraph}
              </p>
            ))}
          </div>
        </article>

        <a
          href="/talleres"
          class="mt-10 inline-flex rounded-button border border-line bg-white px-6 py-4 font-bold text-ink transition hover:-translate-y-1 hover:shadow-soft"
        >
          ← Volver a talleres
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>