<BaseLayout
  title="Información OSC | XentD100cia"
  description="Información práctica para asistir a Open Science Cambre: lugar, fechas, horarios, programa, distribución y recomendaciones."
>
  <Navbar />

  <main>
    <section class="bg-midnight px-5 pb-24 pt-40 text-white md:pb-32 md:pt-48">
      <div class="mx-auto max-w-5xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.3em] text-bioTeal">
          Información para asistentes
        </p>

        <h1 class="font-heading text-5xl font-extrabold tracking-tight md:text-7xl">
          Todo lo que necesitas saber sobre la OSC
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/75">
          Aquí encontrarás la información práctica para asistir a la Open Science Cambre:
          fechas, horarios, lugar, programa, distribución de espacios y recomendaciones.
        </p>
      </div>
    </section>

    <section class="px-5 py-24 md:py-32">
      <div class="mx-auto grid max-w-7xl gap-6 md:grid-cols-3">
        <article class="rounded-card border border-line bg-white p-7 shadow-sm">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-bioTeal">
