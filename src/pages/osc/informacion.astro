---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProgramacionOSC from "../../components/ProgramacionesOSC.astro";
import { edicionesOSC } from '../../data/edicionesOSC.js';

const edicionActual =
  edicionesOSC.find((edicion) => edicion.estado === 'actual') ?? edicionesOSC[0];

const mapaFeria = '/images/images/osc/plano_OSC26.png';

const mesasFeria = [
  
];
---

<BaseLayout
  title="Información OSC | XentD100cia"
  description="Información práctica para asistir a Open Science Cambre: lugar, fechas, horarios, programa, distribución y recomendaciones."
>
  <Navbar />

  <main>
    <section class="bg-midnight px-5 pb-24 pt-40 text-white md:pb-32 md:pt-48">
      <div class="mx-auto max-w-5xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.3em] text-bioTeal">
          Información para asistentes
        </p>

        <h1 class="font-heading text-5xl font-extrabold tracking-tight md:text-7xl">
          Todo lo que necesitas saber sobre la OSC
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/75">
          Aquí encontrarás la información práctica para asistir a la Open Science Cambre:
          fechas, horarios, lugar, programa, distribución de espacios y recomendaciones.
        </p>
      </div>
    </section>

    <section class="px-5 py-24 md:py-32">
      <div class="mx-auto grid max-w-7xl gap-6 md:grid-cols-3">
        <article class="rounded-card border border-line bg-white p-7 shadow-sm">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-bioTeal">
            Fecha
          </p>
          <h2 class="font-heading text-2xl font-bold text-ink">
            {edicionActual.date}
          </h2>
          <p class="mt-3 leading-7 text-soft">
            La feria se desarrollará durante varios días con actividades para distintos públicos.
          </p>
        </article>

        <article class="rounded-card border border-line bg-white p-7 shadow-sm">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-bioTeal">
            Lugar
          </p>
          <h2 class="font-heading text-2xl font-bold text-ink">
            {edicionActual.lugar}
            </h2>
            <p class="mt-3 leading-7 text-soft">
            La feria se celebrará en el Parque de la Iglesia de Cambre.
            </p>
        </article>

        <article class="rounded-card border border-line bg-white p-7 shadow-sm">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-bioTeal">
            Entrada
          </p>
          <h2 class="font-heading text-2xl font-bold text-ink">
            {edicionActual.entrada} 
          </h2>
          <p class="mt-3 leading-7 text-soft">
            La entrada a la feria será libre, aunque alugunos talleres tendran aforo limitado.
          </p>
        </article>
      </div>
    </section>

    <section class="bg-white px-5 py-24 md:py-32">
      <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Ubicación
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Dónde se celebrará OSC
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Open Science Cambre se celebrará en el Parque de la Iglesia de Cambre,
            un espacio céntrico y abierto, ideal para acercar la ciencia a la comunidad.
          </p>

          <div class="mt-8 rounded-card border border-line bg-scienceWhite p-6">
            <p class="font-heading text-xl font-bold text-ink">
              Parque de la Iglesia de Cambre
            </p>

            <p class="mt-2 leading-7 text-soft">
              Aquí tendrá lugar la feria. Más adelante añadiremos información sobre accesos,
              distribución de espacios, puntos de información y recomendaciones para asistentes.
            </p>

            <a
              href="https://www.google.com/maps/search/?api=1&query=Parque%20de%20la%20Iglesia%2C%20Cambre%2C%20A%20Coru%C3%B1a"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-flex font-bold text-discovery"
            >
              Abrir ruta en Google Maps →
            </a>
          </div>
        </div>

        <div class="overflow-hidden rounded-[32px] border border-line bg-white shadow-soft">
          <iframe
            title="Mapa de Open Science Cambre"
            src="https://www.google.com/maps?q=Parque%20de%20la%20Iglesia%2C%20Cambre%2C%20A%20Coru%C3%B1a&output=embed"
            class="h-[420px] w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>

    <section class="px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Horario
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Horarios de la feria
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Open Science Cambre se celebrará del 18 al 20 de septiembre.
            Cada día tendrá su propio horario y programa de actividades.
          </p>
        </div>

          <div class="mt-10 grid gap-6 md:grid-cols-3">
            {(edicionActual.horario ?? []).map((item) => (
              <article class="rounded-card border border-line bg-scienceWhite p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-soft">
                <p class="mb-5 text-sm font-bold uppercase tracking-[0.22em] text-bioTeal">
                  {item.dia}
                </p>

                <div class="rounded-2xl bg-white p-5">
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-soft">
                    Horario
                  </p>

                  <p class="mt-2 font-heading text-2xl font-extrabold text-ink">
                    {item.hora}
                  </p>
                </div>

                <h3 class="mt-6 font-heading text-2xl font-bold text-ink">
                  {item.actividad}
                </h3>

              </article>
            ))}
          </div>
      </div>
    </section>

    <div id="programa-osc">
      <ProgramacionOSC />
    </div>

    <section id="distribucion-feria" class="scroll-mt-32 bg-white px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 max-w-3xl">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Espacios
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Distribución de la feria
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Aquí puedes consultar el plano de la feria y la asignación de mesas de
            los proyectos participantes.
          </p>
        </div>

        <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <article class="overflow-hidden rounded-[32px] border border-line bg-white shadow-soft">
            <div class="border-b border-line p-6 md:p-8">
              <p class="mb-2 text-sm font-bold uppercase tracking-[0.22em] text-bioTeal">
                Plano
              </p>

              <h3 class="font-heading text-3xl font-extrabold text-ink">
                Mapa de espacios
              </h3>

              <p class="mt-3 leading-7 text-soft">
                Consulta la ubicación de mesas, accesos, puntos de información y
                espacios principales de Open Science Cambre.
              </p>
            </div>

            <a
              href={mapaFeria}
              target="_blank"
              rel="noopener noreferrer"
              class="block bg-scienceWhite"
            >
              <img
                src={mapaFeria}
                alt="Mapa de distribución de espacios de Open Science Cambre"
                class="h-auto w-full object-contain"
              />
            </a>

            <div class="border-t border-line p-6 md:p-8">
              <a
                href={mapaFeria}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex rounded-button bg-discovery px-6 py-4 font-bold text-white transition hover:-translate-y-1 hover:bg-bioTeal"
              >
                Abrir mapa ampliado
              </a>
            </div>
          </article>

          <article class="rounded-[32px] border border-line bg-scienceWhite p-6 shadow-sm md:p-8">
            <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="mb-2 text-sm font-bold uppercase tracking-[0.22em] text-bioTeal">
                  Mesas
                </p>

                <h3 class="font-heading text-3xl font-extrabold text-ink">
                  Proyectos asignados
                </h3>
              </div>

              <p class="text-sm font-bold text-soft">
                Página <span data-mesas-current>1</span> / <span data-mesas-total>1</span>
              </p>
            </div>

            <div data-mesas-list class="grid gap-4">
              {mesasFeria.map((item, index) => (
                <article
                  data-mesa-card
                  class:list={[
                    'rounded-3xl border border-line bg-white p-4 shadow-sm',
                    index >= 4 && 'hidden'
                  ]}
                >
                  <div class="flex gap-4">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-midnight font-heading text-lg font-extrabold text-white">
                      {item.mesa}
                    </div>

                    <div class="min-w-0 flex-1">
                      <p class="text-xs font-bold uppercase tracking-[0.18em] text-bioTeal">
                        Mesa {item.mesa}{item.dia ? ` · ${item.dia}` : ''}
                      </p>

                      <h4 class="mt-2 font-heading text-xl font-bold leading-tight text-ink">
                        {item.proyecto}
                      </h4>

                      <p class="mt-2 leading-7 text-soft">
                        {item.centro}
                      </p>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            {mesasFeria.length > 4 && (
              <div class="mt-8 flex items-center justify-center gap-6">
                <button
                  type="button"
                  data-mesas-prev
                  class="flex h-12 w-12 items-center justify-center rounded-full border border-line bg-white font-heading text-xl font-bold text-ink shadow-sm transition hover:-translate-y-1 hover:shadow-soft disabled:cursor-not-allowed disabled:opacity-40"
                  aria-label="Ver mesas anteriores"
                >
                  ←
                </button>

                <button
                  type="button"
                  data-mesas-next
                  class="flex h-12 w-12 items-center justify-center rounded-full border border-line bg-white font-heading text-xl font-bold text-ink shadow-sm transition hover:-translate-y-1 hover:shadow-soft disabled:cursor-not-allowed disabled:opacity-40"
                  aria-label="Ver más mesas"
                >
                  →
                </button>
              </div>
            )}
          </article>
        </div>
      </div>
    </section>

    <section class="bg-white px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Preguntas frecuentes
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Antes de venir
          </h2>
        </div>

        <div class="mx-auto grid max-w-5xl gap-5">
          <div class="rounded-card border border-line bg-scienceWhite p-6">
            <h3 class="font-heading text-xl font-bold text-ink">
              ¿A qué público está dirigida la feria?
            </h3>
            <p class="mt-2 leading-7 text-soft">
              Open Science Cambre está pensada para público general, familias, infancia,
              juventud y cualquier persona con curiosidad por la ciencia.
            </p>
          </div>

          <div class="rounded-card border border-line bg-scienceWhite p-6">
            <h3 class="font-heading text-xl font-bold text-ink">
              ¿Habrá actividades para niños y niñas?
            </h3>
            <p class="mt-2 leading-7 text-soft">
              Sí. El programa incluirá actividades participativas y experiencias divulgativas
              adaptadas a distintos públicos.
            </p>
          </div>

          <div class="rounded-card border border-line bg-scienceWhite p-6">
            <h3 class="font-heading text-xl font-bold text-ink">
              ¿Dónde podré consultar el programa completo?
            </h3>
            <p class="mt-2 leading-7 text-soft">
              El programa completo se publicará en esta página cuando esté cerrado.
            </p>
          </div>

          <div class="rounded-card border border-line bg-scienceWhite p-6">
            <h3 class="font-heading text-xl font-bold text-ink">
              ¿A quién debo dirigirme en caso de duda?
            </h3>
            <p class="mt-2 leading-7 text-soft">
              Si te surge alguna duda durante la feria podras ponerte en contacto con cualquiera que lleve un chaleco negro de la asociación.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = Array.from(document.querySelectorAll('[data-mesa-card]'));
    const prevButton = document.querySelector('[data-mesas-prev]');
    const nextButton = document.querySelector('[data-mesas-next]');
    const currentElement = document.querySelector('[data-mesas-current]');
    const totalElement = document.querySelector('[data-mesas-total]');
    const section = document.querySelector('#distribucion-feria');

    if (!cards.length || !currentElement || !totalElement) return;

    const itemsPerPage = 4;
    const totalPages = Math.ceil(cards.length / itemsPerPage);
    let currentPage = 1;

    const renderPage = () => {
      cards.forEach((card, index) => {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        card.classList.toggle('hidden', index < start || index >= end);
      });

      currentElement.textContent = String(currentPage);
      totalElement.textContent = String(totalPages);

      if (prevButton) {
        prevButton.disabled = currentPage === 1;
      }

      if (nextButton) {
        nextButton.disabled = currentPage === totalPages;
      }
    };

    prevButton?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage -= 1;
        renderPage();

        section?.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });

    nextButton?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage += 1;
        renderPage();

        section?.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });

    renderPage();
  });
</script>

</BaseLayout>