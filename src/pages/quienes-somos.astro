---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const valores = [
  {
    title: 'Ciencia cercana',
    text: 'Queremos que la ciencia deje de parecer algo lejano y se convierta en una forma de mirar el mundo con curiosidad.'
  },
  {
    title: 'Aprender haciendo',
    text: 'Diseñamos actividades manipulativas, visuales y participativas, donde tocar, probar y preguntar forma parte del aprendizaje.'
  },
  {
    title: 'Divulgación rigurosa',
    text: 'Buscamos explicar ciencia de forma clara y accesible, sin perder el respeto por el conocimiento científico.'
  },
  {
    title: 'Comunidad',
    text: 'Creemos en crear espacios donde infancia, juventud, familias, centros, entidades y personas curiosas puedan descubrir ciencia juntas.'
  }
];

const manifiesto = [
  {
    title: 'Prohibido no tocar',
    text: 'La ciencia también se entiende con las manos: manipulando, probando, construyendo y experimentando.'
  },
  {
    title: 'Prohibido no preguntar',
    text: 'Una buena pregunta puede abrir más caminos que una respuesta cerrada.'
  },
  {
    title: 'Prohibido no equivocarse',
    text: 'El error no es el final del aprendizaje; muchas veces es donde empieza lo interesante.'
  },
  {
    title: 'Prohibido no probar',
    text: 'No queremos que la ciencia se mire desde lejos: queremos que se viva desde dentro.'
  },
  {
    title: 'Prohibido no compartir',
    text: 'La ciencia crece cuando se explica, se adapta, se conversa y se pone al alcance de más personas.'
  },
  {
    title: 'Prohibido no copiar',
    text: 'Pero copiar como la ciencia: observando, citando, mejorando, adaptando y compartiendo.'
  }
];

const hacemos = [
  {
    title: 'Talleres científicos',
    text: 'Preparamos talleres prácticos donde las personas participantes pueden experimentar, preguntar y descubrir ciencia de forma activa.',
    href: '/talleres',
    button: 'Ver talleres'
  },
  {
    title: 'Open Science Cambre',
    text: 'Organizamos una feria científica abierta a la comunidad, donde centros, asociaciones e instituciones comparten ciencia con el público.',
    href: '/osc',
    button: 'Conocer OSC'
  },
  {
    title: 'Actividades y ferias',
    text: 'Participamos en espacios de divulgación científica con experimentos, juegos y propuestas pensadas para aprender tocando.',
    href: '/noticias',
    button: 'Ver noticias'
  }
];

const principios = [
  'Menos mirar desde lejos, más experimentar.',
  'Menos tecnicismos innecesarios, más lenguaje claro.',
  'Menos ciencia como escaparate, más ciencia compartida.',
  'Menos miedo a preguntar, más curiosidad.'
];
---

<BaseLayout
  title="Quiénes somos | XentD100cia"
  description="Conoce XentD100cia, una asociación juvenil de divulgación científica que diseña talleres, actividades y Open Science Cambre para acercar la ciencia a la comunidad."
>
  <Navbar />

  <main>
    <section class="bg-midnight px-5 pb-24 pt-40 text-white md:pb-32 md:pt-48">
      <div class="mx-auto max-w-5xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.3em] text-bioTeal">
          Quiénes somos
        </p>

        <h1 class="font-heading text-5xl font-extrabold tracking-tight md:text-7xl">
          Una asociación para vivir la ciencia
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/75">
          XentD100cia es una asociación juvenil de divulgación científica nacida
          para acercar la ciencia a la comunidad mediante talleres, ferias y
          experiencias participativas pensadas para tocar, probar y descubrir.
        </p>
      </div>
    </section>

    <section class="px-5 py-24 md:py-32">
      <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-[0.9fr_1.1fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Nuestra idea
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Ciencia que se toca, se prueba y se comparte
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Creemos que la ciencia se entiende mejor cuando deja de ser solo una
            explicación y se convierte en una experiencia. Por eso diseñamos actividades
            en las que las personas pueden manipular, observar, equivocarse, preguntar
            y descubrir por sí mismas.
          </p>

          <p class="mt-5 text-lg leading-8 text-soft">
            Nuestro objetivo es crear espacios de divulgación cercanos, participativos
            y rigurosos, especialmente pensados para que infancia, juventud, familias
            y público general puedan acercarse a la ciencia con curiosidad y sin miedo a preguntar.
          </p>
        </div>

        <div class="rounded-[32px] bg-midnight p-8 text-white shadow-soft md:p-12">
          <p class="mb-4 inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-bold backdrop-blur">
            Prohibido no tocar
          </p>

          <h3 class="font-heading text-3xl font-extrabold">
            La ciencia también se aprende con las manos.
          </h3>

          <p class="mt-5 leading-8 text-white/70">
            Esta idea resume nuestra forma de trabajar: actividades prácticas,
            lenguaje claro y participación activa para que la ciencia se viva desde dentro.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-white px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Valores
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Nuestra forma de divulgar
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            No entendemos la ciencia como algo que se mira desde fuera,
            sino como algo que se pregunta, se experimenta y se comparte.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {valores.map((valor) => (
            <article class="rounded-card border border-line bg-scienceWhite p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-soft">
              <h3 class="font-heading text-2xl font-bold text-ink">
                {valor.title}
              </h3>

              <p class="mt-4 leading-7 text-soft">
                {valor.text}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

        <section class="px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Manifiesto
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Frases que nos definen
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Algunas ideas resumen nuestra forma de vivir la ciencia:
            tocar, preguntar, probar, equivocarse, compartir y aprender con otras personas.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {manifiesto.map((frase) => (
            <article class="rounded-card border border-line bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-soft">
              <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-bioTeal">
                XentD100cia
              </p>

              <h3 class="font-heading text-3xl font-extrabold text-ink">
                {frase.title}
              </h3>

              <p class="mt-5 leading-8 text-soft">
                {frase.text}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 max-w-3xl">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Qué hacemos
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Qué hacemos para acercar la ciencia
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            XentD100cia desarrolla propuestas de divulgación científica en distintos formatos:
            talleres, actividades en ferias, iniciativas comunitarias y la Open Science Cambre.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
          {hacemos.map((item) => (
            <article class="rounded-card border border-line bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-soft">
              <h3 class="font-heading text-2xl font-bold text-ink">
                {item.title}
              </h3>

              <p class="mt-4 leading-7 text-soft">
                {item.text}
              </p>

              <a
                href={item.href}
                class="mt-6 inline-flex rounded-button bg-discovery px-6 py-3 font-bold text-white transition hover:-translate-y-1 hover:bg-bioTeal"
              >
                {item.button}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-midnight px-5 py-24 text-white md:py-32">
      <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-[0.8fr_1.2fr] md:items-center">
        <div>
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Nuestra forma de trabajar
          </p>

          <h2 class="font-heading text-4xl font-extrabold md:text-5xl">
            Diseñar experiencias, no solo explicar contenidos
          </h2>

          <p class="mt-5 text-lg leading-8 text-white/70">
            Cada actividad nace de una pregunta: cómo conseguir que una persona
            pueda entender mejor una idea científica viviéndola de forma activa.
          </p>
        </div>

        <div class="grid gap-4">
          {principios.map((principio, index) => (
            <div class="rounded-card border border-white/10 bg-white/5 p-6 backdrop-blur">
              <p class="text-sm font-bold uppercase tracking-[0.2em] text-bioTeal">
                Clave {index + 1}
              </p>

              <p class="mt-3 font-heading text-2xl font-bold">
                {principio}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 py-24 md:py-32">
      <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1fr_1fr] md:items-center">
        <div class="rounded-[32px] border border-line bg-scienceWhite p-8 shadow-sm md:p-12">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Desde Cambre
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Un proyecto joven con vocación comunitaria
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            XentD100cia crece desde Cambre, pero con la mirada puesta en crear redes:
            con centros educativos, asociaciones, instituciones, proyectos científicos,
            familias y personas curiosas.
          </p>

          <p class="mt-5 text-lg leading-8 text-soft">
            Queremos que la divulgación científica sea una forma de encuentro:
            una excusa para preguntar, participar y construir comunidad alrededor
            del conocimiento.
          </p>
        </div>

        <div class="rounded-[32px] bg-midnight p-8 text-white shadow-soft md:p-12">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Próximamente
          </p>

          <h3 class="font-heading text-3xl font-extrabold">
            Aquí podremos presentar al equipo
          </h3>

          <p class="mt-5 leading-8 text-white/70">
            Más adelante añadiremos una sección con las personas que forman parte
            de la asociación, sus roles y la forma en la que contribuyen al proyecto.
          </p>
        </div>
      </div>
    </section>

    <section class="px-5 pb-28">
      <div class="mx-auto rounded-[32px] bg-midnight px-8 py-20 text-center text-white md:max-w-7xl">
        <h2 class="font-heading text-4xl font-extrabold md:text-5xl">
          ¿Quieres formar parte?
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/75">
          Si compartes esta forma de vivir la ciencia, puedes contactar con
          XentD100cia para participar, colaborar o proponer nuevas ideas.
        </p>

        <a
          href="/contacto#participacion"
          class="mt-8 inline-flex rounded-button bg-discovery px-7 py-4 font-bold text-white transition hover:-translate-y-1 hover:bg-bioTeal"
        >
          Quiero contactar
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
