---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const motivosContacto = [
  {
    title: 'Participar en la OSC',
    text: 'Si quieres participar de una forma activa, creando, compartiendo y ayudando a los demás, haz clic y mira en que encajas mejor.',
    buttonActivo: 'Participar en la OSC',
    buttonInactivo: 'Ya tenemos a todos los participantes',
    hrefActivo: '/osc#participacion',
    hrefInactivo: '/osc#canales',
    formularioActivo: true
  },
  {
    title: 'Voluntariado',
    text: 'Para personas que quieran ayudar en la organización, montaje, atención al público, acompañamiento de entidades o apoyo logístico.',
    buttonActivo: 'Quiero ser voluntario/a',
    buttonInactivo: 'Quiero ser voluntario/a',
    hrefActivo: 'mailto:opensciencecambre@gmail.com?subject=Voluntariado',
    hrefInactivo: 'mailto:opensciencecambre@gmail.com?subject=Voluntariado',
    formularioActivo: true
  },
  {
    title: 'Proponer un taller',
    text: 'Para sugerir temas, ideas o actividades que podrían convertirse en futuros talleres de XentD100cia.',
    buttonActivo: 'Proponer taller',
    buttonInactivo: 'Proponer taller',
    hrefActivo: 'https://forms.gle/ASZ5pPBz3gGR1Mej',
    hrefInactivo: 'https://forms.gle/ASZ5pPBz3gGR1Mej6',
    formularioActivo: true
  },
  {
    title: 'Contacto general',
    text: 'Para cualquier otra consulta relacionada con la asociación, actividades, colaboraciones, comunicación o participación.',
    buttonActivo: 'Escríbenos',
    buttonInactivo: 'Escríbenos',
    hrefActivo: '#canales',
    hrefInactivo: '#canales',
    formularioActivo: true
  }
];
const correosContacto = [
  {
    title: 'Asociación XentD100cia',
    email: 'asociacionxentd100cia@gmail.com',
    text: 'Para consultas generales sobre la asociación, talleres, colaboraciones y actividades de XentD100cia.',
    subject: 'Contacto con XentD100cia'
  },
  {
    title: 'Open Science Cambre',
    email: 'opensciencecambre@gmail.com',
    text: 'Para consultas relacionadas con Open Science Cambre, participación, acogidas, voluntariado o entidades colaboradoras.',
    subject: 'Contacto sobre Open Science Cambre'
  }
];

const redesSociales = [
  {
    name: 'XentD100cia',
    handle: '@xentd100cia',
    platform: 'Instagram',
    href: 'https://www.instagram.com/xentd100cia'
  },
  {
    name: 'Open Science Cambre',
    handle: '@opensciencecambre',
    platform: 'Instagram',
    href: 'https://www.instagram.com/opensciencecambre'
  },
  {
    name: 'Lab Bio',
    handle: 'Lab Bio',
    platform: 'Facebook',
    href: 'https://www.facebook.com/lab.bio.946#'
  },
  {
    name: 'Open Science Cambre',
    handle: '@openscience_',
    platform: 'X',
    href: 'https://x.com/openscience_'
  },
  {
    name: 'Open Science Cambre',
    handle: '@opensciencecambre',
    platform: 'TikTok',
    href: 'https://www.tiktok.com/@opensciencecambre'
  }
];
---

<BaseLayout
  title="Contacto | XentD100cia"
  description="Contacta con XentD100cia para participar en talleres, Open Science Cambre, voluntariado, acogidas o colaboraciones."
>
  <Navbar />

  <main>
    <section class="bg-midnight px-5 pb-24 pt-40 text-white md:pb-32 md:pt-48">
      <div class="mx-auto max-w-5xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.3em] text-bioTeal">
          Contacto
        </p>

        <h1 class="font-heading text-5xl font-extrabold tracking-tight md:text-7xl">
          ¿Hablamos de ciencia?
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/75">
          Si quieres participar en nuestras actividades, colaborar con la asociación, proponer un taller o resolver alguna duda, 
          aquí puedes encontrar la mejor forma de contactar con XentD100cia.
        </p>
      </div>
    </section>

    <section id="participacion" class="px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Contacto y participación
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Elige cómo quieres contactar
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Para que podamos responderte mejor, selecciona la vía que más se ajusta
            a lo que necesitas.
          </p>
        </div>

        <div class="mx-auto flex max-w-5xl flex-col gap-6">
          {motivosContacto.map((motivo) => (
            <article class="rounded-[28px] border border-line bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-soft md:p-8">
              <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
                <div class="max-w-2xl">
                  <h3 class="font-heading text-2xl font-bold text-ink">
                    {motivo.title}
                  </h3>

                  <p class="mt-3 leading-7 text-soft">
                    {motivo.text}
                  </p>
                </div>

                <a
                  href={motivo.formularioActivo ? motivo.hrefActivo : motivo.hrefInactivo}
                  class:list={[
                    'inline-flex rounded-button px-6 py-4 font-bold transition',
                    motivo.formularioActivo
                      ? 'bg-discovery text-white hover:-translate-y-1 hover:bg-bioTeal'
                      : 'border border-line bg-white text-soft hover:-translate-y-1 hover:shadow-soft'
                  ]}
                >
                  {motivo.formularioActivo ? motivo.buttonActivo : motivo.buttonInactivo}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="canales" class="overflow-hiden bg-white px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 max-w-3xl">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Canales
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Dónde encontrarnos
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Puedes contactar con XentD100cia por correo electrónico o seguir nuestras
            redes para estar al tanto de talleres, actividades y novedades de Open
            Science Cambre.
          </p>
        </div>

        <div class="grid min-w-0 gap-8 lg:grid-cols-[1.05fr_0.95fr]">
          <article class="min-w-0 rounded-[28px] bg-midnight p-6 text-white shadow-soft md:rounded-[32px]p-10">
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
              Correos principales
            </p>

            <h3 class="font-heading text-3xl font-extrabold md:text-4xl">
              Escríbenos por email
            </h3>

            <p class="mt-5 leading-8 text-white/65">
              Usa el correo que mejor encaje con tu consulta. Así podremos responderte
              de forma más ordenada.
            </p>

            <div class="mt-8 grid gap-4">
              {correosContacto.map((correo) => (
                <div class="rounded-3xl border border-white/10 bg-white/5 p-4 sm:p-5">
                  <p class="text-sm font-bold uppercase tracking-[0.18em] text-bioTeal">
                    {correo.title}
                  </p>

                  <p class="mt-3 leading-7 text-white/70">
                    {correo.text}
                  </p>

                  <div class="mt-5 flex flex-col items-start gap-3 md:flex-row md:items-center md:gap-5">
                    <a
                      href={`https://mail.google.com/mail/?view=cm&fs=1&to=${correo.email}&su=${encodeURIComponent(correo.subject)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex max-w-full rounded-button bg-discovery px-4 py-3 text-[13px] font-bold text-white transition hover:-translate-y-1 hover:bg-bioTeal sm:text-sm md:px-5 md:text-base"
                    >
                      <span class="whitespace-nowrap">
                        {correo.email}
                      </span>
                    </a>

                    <button
                      type="button"
                      data-copy-email={correo.email}
                      class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white/65 transition hover:-translate-y-0.5 hover:bg-white/10 hover:text-white"
                      aria-label={`Copiar ${correo.email}`}
                      title="Copiar correo"
                    >
                      <svg
                        data-copy-icon
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                        aria-hidden="true"
                      >
                        <rect x="9" y="9" width="10" height="10" rx="2" />
                        <path d="M5 15V7a2 2 0 0 1 2-2h8" />
                      </svg>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </article>

          <div class="grid gap-6">
            <article class="rounded-card border border-line bg-scienceWhite p-8 shadow-sm">
              <h3 class="font-heading text-2xl font-bold text-ink">
                Redes sociales
              </h3>

              <p class="mt-3 leading-7 text-soft">
                Cada cuenta tiene su propio espacio. Puedes seguirnos según la red
                que utilices o el proyecto que quieras consultar.
              </p>

              <div class="mt-6 grid gap-3">
                {redesSociales.map((red) => (
                  <a
                    href={red.href}
                    target={red.href === '#' ? undefined : '_blank'}
                    rel={red.href === '#' ? undefined : 'noopener noreferrer'}
                    class="group flex min-w-0 items-center gap-4 rounded-2xl border border-line bg-white p-4 transition hover:-translate-y-1 hover:shadow-soft"
                  >
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-midnight text-white transition group-hover:bg-discovery sm:h-11 sm:w-11">
                      {red.platform === 'Instagram' && (
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                          <rect x="3" y="3" width="18" height="18" rx="5" />
                          <circle cx="12" cy="12" r="4" />
                          <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
                        </svg>
                      )}

                      {red.platform === 'Facebook' && (
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                          <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.5 1.6-1.5h1.7V4.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V11H7.4v3h2.7v8h3.4z" />
                        </svg>
                      )}

                      {red.platform === 'X' && (
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                          <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-5-7.5L5.2 22H2l7.3-8.4L1.7 2h6.5l4.5 6.7L18.9 2Zm-1.1 17.8h1.7L7.3 4.1H5.5l12.3 15.7Z" />
                        </svg>
                      )}

                      {red.platform === 'TikTok' && (
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                          <path d="M16.6 3c.4 2.3 1.7 3.7 4 3.9v3.1c-1.3.1-2.7-.3-4-1.1v5.9c0 3.8-2.1 6.2-5.5 6.2-3.1 0-5.5-2.2-5.5-5.2 0-3.4 2.8-5.8 6.4-5.1v3.3c-1.6-.5-3.1.4-3.1 1.8 0 1.1.9 1.9 2.1 1.9 1.4 0 2.2-.8 2.2-2.6V3h3.4Z" />
                        </svg>
                      )}
                    </span>

                    <span class="min-w-0">
                      <span class="block text-xs font-bold uppercase tracking-[0.18em] text-bioTeal">
                        {red.platform}
                      </span>

                      <span class="mt-1 block whitespace-nowrap font-heading text-x[l.25rem] font-bold leading-tinght text-ink sm:text-x1">
                        {red.handle}
                      </span>

                      <span class="mt-1 block text-sm text-soft">
                        {red.name}
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 pb-28">
      <div class="mx-auto rounded-[32px] bg-midnight px-8 py-20 text-center text-white md:max-w-7xl">
        <h2 class="font-heading text-4xl font-extrabold md:text-5xl">
          Gracias por querer formar parte
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/75">
          XentD100cia crece con personas, centros y entidades que creen que la ciencia
          se entiende mejor cuando se toca, se comparte y se vive.
        </p>
      </div>
    </section>
  </main>

  <Footer />

<script>
  const copyEmailButtons = document.querySelectorAll('[data-copy-email]');

  copyEmailButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const email = button.getAttribute('data-copy-email');

      if (!email) return;

      const originalContent = button.innerHTML;

      try {
        await navigator.clipboard.writeText(email);

        button.innerHTML = `
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M20 6L9 17l-5-5" />
          </svg>
        `;

        setTimeout(() => {
          button.innerHTML = originalContent;
        }, 1800);
      } catch (error) {
        button.innerHTML = `
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M18 6L6 18" />
            <path d="M6 6l12 12" />
          </svg>
        `;

        setTimeout(() => {
          button.innerHTML = originalContent;
        }, 1800);
      }
    });
  });
</script>

</BaseLayout>
