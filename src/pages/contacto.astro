---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const motivosContacto = [
  {
    title: 'Participar en la OSC',
    text: 'Para centros, asociaciones, instituciones o proyectos que quieran formar parte de la Open Science Cambre con una actividad divulgativa.',
    button: 'Participar en la OSC',
    href: 'mailto:contacto@xentd100cia.org?subject=Participar%20en%20OSC'
  },
  {
    title: 'Programa de acogidas',
    text: 'Para familias de Cambre interesadas en ayudar con el programa de acogida durante la Open Science Cambre.',
    button: 'Formulario acogidas',
    href: 'mailto:contacto@xentd100cia.org?subject=Programa%20de%20acogidas'
  },
  {
    title: 'Voluntariado',
    text: 'Para personas que quieran ayudar en organización, montaje, acompañamiento de entidades, atención al público o apoyo logístico.',
    button: 'Quiero ser voluntario/a',
    href: 'mailto:contacto@xentd100cia.org?subject=Voluntariado'
  },
  {
    title: 'Proponer un taller',
    text: 'Para sugerir temas, ideas o actividades que podrían convertirse en futuros talleres de XentD100cia.',
    button: 'Proponer taller',
    href: 'https://forms.gle/ASZ5pPBz3gGR1Mej6'
  },
  {
    title: 'Contacto general',
    text: 'Para cualquier otra consulta relacionada con la asociación, actividades, colaboraciones, comunicación o participación.',
    button: 'Escribirnos',
    href: '#canales'
  }
];

const canales = [
  {
    title: 'Correo electrónico',
    text: 'opensciencecambre@gmail.com',
    note: 'Si te surge alguna duda o quieres proponer algo no dudes en escribirnos.'
  },
  {
    title: 'Redes sociales',
    text: '@xentd100cia',
    note: 'Síguenos para estar al tanto de talleres, actividades y novedades de la asociación y/o de la Open Science Cambre.'
  },
  {
    title: 'Dónde estamos',
    text: 'Cambre',
    note: 'Desarrollamos activdades de divulgación científica desde Cambre y para la comunidad.'
  }
];
---

<BaseLayout
  title="Contacto | XentD100cia"
  description="Contacta con XentD100cia para participar en talleres, Open Science Cambre, voluntariado, acogidas o colaboraciones."
>
  <Navbar />

  <main>
    <section class="bg-midnight px-5 pb-24 pt-40 text-white md:pb-32 md:pt-48">
      <div class="mx-auto max-w-5xl text-center">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.3em] text-bioTeal">
          Contacto
        </p>

        <h1 class="font-heading text-5xl font-extrabold tracking-tight md:text-7xl">
          ¿Hablamos de ciencia?
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/75">
          Si quieres participar en nuestras actividades, colaborar con la asociación, proponer un taller o resolver alguna duda, 
          aquí puedes encontrar la mejor forma de contactar con XentD100cia.
        </p>
      </div>
    </section>

    <section id="participacion" class="px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Contacto y participación
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Elige cómo quieres contactar
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Para que podamos responderte mejor, selecciona la vía que más se ajusta
            a lo que necesitas.
          </p>
        </div>

        <div class="mx-auto flex max-w-5xl flex-col gap-6">
          {motivosContacto.map((motivo) => (
            <article class="rounded-[28px] border border-line bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-soft md:p-8">
              <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
                <div class="max-w-2xl">
                  <h3 class="font-heading text-2xl font-bold text-ink">
                    {motivo.title}
                  </h3>

                  <p class="mt-3 leading-7 text-soft">
                    {motivo.text}
                  </p>
                </div>

                <a
                  href={motivo.href}
                  class="inline-flex shrink-0 rounded-button bg-discovery px-6 py-3 text-center font-bold text-white transition hover:-translate-y-1 hover:bg-bioTeal"
                >
                  {motivo.button}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

        <section id="canales" class="bg-white px-5 py-24 md:py-32">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 max-w-3xl">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
            Canales
          </p>

          <h2 class="font-heading text-4xl font-extrabold text-ink md:text-5xl">
            Dónde encontrarnos
          </h2>

          <p class="mt-5 text-lg leading-8 text-soft">
            Puedes contactar con XentD100cia por correo electrónico o seguir nuestras redes
            para estar al tanto de talleres, actividades y novedades de Open Science Cambre.
          </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
          <article class="rounded-[32px] bg-midnight p-8 text-white shadow-soft md:p-10">
            <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">
              Correo principal
            </p>

            <h3 class="font-heading text-3xl font-extrabold md:text-4xl">
              Escríbenos por email
            </h3>

            <p class="mt-4 leading-8 text-white/70">
              Para consultas sobre talleres, Open Science Cambre, colaboraciones,
              acogidas, voluntariado o contacto general.
            </p>

            <a
              href="https://mail.google.com/mail/?view=cm&fs=1&to=opensciencecambre@gmail.com&su=Contacto%20con%20XentD100cia"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex max-w-full rounded-button bg-discovery px-6 py-4 text-center font-bold text-white transition hover:-translate-y-1 hover:bg-bioTeal"
            >
              Escribir a opensciencecambre@gmail.com
            </a>
          </article>

          <div class="grid gap-6">
            <article class="rounded-card border border-line bg-scienceWhite p-7 shadow-sm">
              <h3 class="font-heading text-2xl font-bold text-ink">
                Redes sociales
              </h3>

              <a
                href="https://www.instagram.com/xentd100cia"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex font-heading text-2xl font-extrabold text-discovery"
              >
                @xentd100cia
              </a>

              <a
                href="https://www.instagram.com/opensciencecambre"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex font-heading text-2xl font-extrabold text-discovery"
              >
                @opensciencecambre
              </a>

              <a
                href= "/contacto"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex font-heading text-2xl font-extrabold text-discovery"
              >
                @Lab Bio
              </a>

              <a
                href= "https://x.com/openscience_"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex font-heading text-2xl font-extrabold text-discovery"
              >
                @openscience_
              </a>

              <p class="mt-3 leading-7 text-soft">
                Síguenos para estar al tanto de talleres, actividades, novedades de la asociación
                y Open Science Cambre.
              </p>
            </article>

            <article class="rounded-card border border-line bg-scienceWhite p-7 shadow-sm">
              <h3 class="font-heading text-2xl font-bold text-ink">
                Dónde estamos
              </h3>

              <p class="mt-3 font-heading text-2xl font-extrabold text-discovery">
                Cambre
              </p>

              <p class="mt-3 leading-7 text-soft">
                Desarrollamos actividades de divulgación científica desde Cambre
                y para la comunidad.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 pb-28">
      <div class="mx-auto rounded-[32px] bg-midnight px-8 py-20 text-center text-white md:max-w-7xl">
        <h2 class="font-heading text-4xl font-extrabold md:text-5xl">
          Gracias por querer formar parte
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/75">
          XentD100cia crece con personas, centros y entidades que creen que la ciencia
          se entiende mejor cuando se toca, se comparte y se vive.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
