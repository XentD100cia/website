---
const links = [
  { label: 'Inicio', href: '/' },
  { label: 'Talleres', href: '/talleres' },
  { label: 'OSC', href: '/osc' },
  { label: 'Noticias', href: '/noticias' },
  { label: 'Quiénes somos', href: '/quienes-somos' },
  { label: 'Contacto', href: '/contacto' }
];
---

<header class="fixed left-0 top-0 z-50 w-full px-4 py-4">
  <nav class="mx-auto max-w-7xl rounded-[28px] border border-white/10 bg-midnight/90 px-5 py-3 text-white shadow-soft backdrop-blur">
    <div class="flex items-center justify-between gap-6">
      <a href="/" class="flex items-center gap-3">
        <img
          src="/images/logo-xentd100cia.png"
          alt="Logo de XentD100cia"
          class="h-10 w-10 object-contain"
        />

        <span class="font-heading text-xl font-extrabold">
          XentD100cia
        </span>
      </a>

      <!-- Menú escritorio -->
      <div class="hidden items-center gap-7 lg:flex">
        {links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-bold text-white/80 transition hover:text-bioTeal"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Botón móvil -->
      <button
        type="button"
        data-menu-button
        class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/10 text-white transition hover:bg-white/20 lg:hidden"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <svg
          data-menu-open-icon
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="h-6 w-6"
          aria-hidden="true"
        >
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>

        <svg
          data-menu-close-icon
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="hidden h-6 w-6"
          aria-hidden="true"
        >
          <path d="M6 6l12 12" />
          <path d="M18 6L6 18" />
        </svg>
      </button>
    </div>

    <!-- Menú móvil desplegable -->
    <div
      data-mobile-menu
      class="hidden border-t border-white/10 pt-4 lg:hidden"
    >
      <div class="grid gap-2">
        {links.map((link) => (
          <a
            href={link.href}
            class="rounded-2xl px-4 py-3 text-base font-bold text-white/80 transition hover:bg-white/10 hover:text-bioTeal"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector('[data-menu-button]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const openIcon = document.querySelector('[data-menu-open-icon]');
  const closeIcon = document.querySelector('[data-menu-close-icon]');

  if (menuButton && mobileMenu && openIcon && closeIcon) {
    menuButton.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');

      mobileMenu.classList.toggle('hidden', isOpen);
      openIcon.classList.toggle('hidden', !isOpen);
      closeIcon.classList.toggle('hidden', isOpen);
      menuButton.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
