---
const { eyebrow, title, text } = Astro.props;
---

<div class="mx-auto mb-14 max-w-3xl text-center">
  {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-bioTeal">{eyebrow}</p>}
  <h2 class="font-heading text-4xl font-extrabold tracking-tight text-ink md:text-5xl">{title}</h2>
  {text && <p class="mt-5 text-lg leading-8 text-soft">{text}</p>}
</div>
