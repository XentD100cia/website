---
import '../styles/global.css';

const {
  title = 'XentD100cia | Asociación juvenil de divulgación científica',
  description = 'Aprendemos ciencia experimentando: tocando, probando, preguntando y descubriendo juntos.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
